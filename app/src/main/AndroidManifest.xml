<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".MoniedApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Monied"
        tools:targetApi="31">

        <activity
            android:name=".ui.main.SpendingInsightsActivity"
            android:exported="false"
            android:theme="@style/Theme.Monied.NoActionBar"/>
        <activity
            android:name=".ui.main.SpendingReportActivity"
            android:exported="false"
            android:theme="@style/Theme.Monied.NoActionBar"/>
        <activity
            android:name=".ui.main.CategoryExpensesActivity"
            android:exported="false"
            android:theme="@style/Theme.Monied.NoActionBar"/>
        <activity
            android:name=".ui.main.ViewExpensesActivity"
            android:exported="false"
            android:theme="@style/Theme.Monied.NoActionBar"/>
        <activity
            android:name=".ui.main.SavingsGoalActivity"
            android:exported="false"
            android:theme="@style/Theme.Monied.NoActionBar"/>
        <activity
            android:name=".ui.main.AddExpenseActivity"
            android:exported="false"
            android:theme="@style/Theme.Monied.NoActionBar"/>
        <activity
            android:name=".ui.main.CategoryActivity"
            android:exported="false"
            android:theme="@style/Theme.Monied.NoActionBar"/>
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:parentActivityName=".ui.auth.LoginActivity" />
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.Monied.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Monied.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <!-- File Provider for Camera/Gallery (authority uses your app's package name) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>