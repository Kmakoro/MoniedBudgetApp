<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Header Section with Emerald Background -->
        <View
            android:id="@+id/headerBackground"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:background="@color/emerald_600"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- App Title -->
        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:layout_marginStart="@dimen/spacing_l"
            android:layout_marginTop="@dimen/spacing_m"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Profile Avatar -->
        <ImageView
            android:id="@+id/ivProfileAvatar"
            android:layout_width="@dimen/avatar_size"
            android:layout_height="@dimen/avatar_size"
            android:layout_marginEnd="@dimen/spacing_l"
            android:background="@drawable/circle_background"
            android:contentDescription="@string/cd_profile_avatar"
            android:padding="8dp"
            android:src="@drawable/ic_person"
            app:layout_constraintTop_toTopOf="@id/tvAppTitle"
            app:layout_constraintBottom_toBottomOf="@id/tvAppTitle"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Budget Summary Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBudgetSummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_l"
            app:cardBackgroundColor="#33FFFFFF"
            app:cardCornerRadius="@dimen/corner_radius_large"
            app:cardElevation="0dp"
            app:layout_constraintTop_toBottomOf="@id/tvAppTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_m">

                <TextView
                    android:id="@+id/tvCurrentMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="March 2026 Spending"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_body"
                    android:layout_marginBottom="@dimen/spacing_xs" />

                <TextView
                    android:id="@+id/tvSpendingAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_display"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/spacing_s"
                    tools:text="R 1,245.00" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/spacing_xs">

                    <TextView
                        android:id="@+id/tvMinGoal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_caption"
                        tools:text="Min: R 500" />

                    <TextView
                        android:id="@+id/tvMaxGoal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_caption"
                        tools:text="Max: R 2,000" />

                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressBudget"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/progress_bar_height"
                    android:progressTint="@color/white"
                    android:progressBackgroundTint="#4DFFFFFF"
                    tools:progress="62" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Quick Action Grid (Placeholder - implement with actual buttons) -->
        <LinearLayout
            android:id="@+id/quickActionGrid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_l"
            android:layout_marginTop="@dimen/spacing_m"
            android:orientation="horizontal"
            android:weightSum="4"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/cardBudgetSummary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Quick Actions"
                android:textSize="@dimen/text_caption"
                android:textColor="@color/gray_500"
                android:gravity="center" />

        </LinearLayout>

        <!-- Budget Goals Banner -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBudgetGoals"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_l"
            app:cardBackgroundColor="@color/amber_400"
            app:cardCornerRadius="@dimen/corner_radius_large"
            app:cardElevation="@dimen/elevation_card"
            app:layout_constraintTop_toBottomOf="@id/quickActionGrid"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_m"
                android:text="@string/dashboard_budget_goals"
                android:textColor="@color/white"
                android:textSize="@dimen/text_body_large"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_target"
                android:drawablePadding="@dimen/spacing_xs"
                android:gravity="center_vertical" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Savings & Alerts Cards Row -->
        <LinearLayout
            android:id="@+id/savingsAlertsRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_l"
            android:layout_marginTop="@dimen/spacing_m"
            android:orientation="horizontal"
            android:weightSum="2"
            app:layout_constraintTop_toBottomOf="@id/cardBudgetGoals"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Savings Goals Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSavingsGoals"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/spacing_xs"
                app:cardBackgroundColor="@color/blue_500"
                app:cardCornerRadius="@dimen/corner_radius_large"
                app:cardElevation="@dimen/elevation_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_m"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_savings_goals"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_caption"
                        android:layout_marginBottom="@dimen/spacing_xs" />

                    <TextView
                        android:id="@+id/tvSavingsAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_headline"
                        android:textStyle="bold"
                        tools:text="R 21,300" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Budget Alerts Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBudgetAlerts"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_xs"
                app:cardBackgroundColor="@color/red_500"
                app:cardCornerRadius="@dimen/corner_radius_large"
                app:cardElevation="@dimen/elevation_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_m"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_budget_alerts"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_caption"
                        android:layout_marginBottom="@dimen/spacing_xs" />

                    <TextView
                        android:id="@+id/tvAlertCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_headline"
                        android:textStyle="bold"
                        tools:text="3 New" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Recent Expenses Section -->
        <LinearLayout
            android:id="@+id/recentExpensesHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_l"
            android:layout_marginTop="@dimen/spacing_l"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/savingsAlertsRow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/dashboard_recent_expenses"
                android:textSize="@dimen/text_body_large"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvViewAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_view_all"
                android:textColor="@color/emerald_600"
                android:textSize="@dimen/text_body" />

        </LinearLayout>

        <!-- Recent Expenses List (Placeholder - use RecyclerView in production) -->
        <TextView
            android:id="@+id/tvNoExpenses"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:text="Recent expenses will appear here"
            android:textColor="@color/gray_500"
            android:textSize="@dimen/text_body"
            app:layout_constraintTop_toBottomOf="@id/recentExpensesHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
