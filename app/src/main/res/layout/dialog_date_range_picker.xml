<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quick Select"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <RadioGroup
        android:id="@+id/radioGroupPeriods"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/radioToday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today" />

        <RadioButton
            android:id="@+id/radioThisWeek"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="This Week" />

        <RadioButton
            android:id="@+id/radioThisMonth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="This Month" />

        <RadioButton
            android:id="@+id/radioLast30Days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Last 30 Days" />

    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Custom Range"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnStartDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Start Date"
            style="@style/Widget.Material3.Button.OutlinedButton" />

        <TextView
            android:id="@+id/tvStartDateValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Select"
            android:padding="8dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnEndDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="End Date"
            style="@style/Widget.Material3.Button.OutlinedButton" />

        <TextView
            android:id="@+id/tvEndDateValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Select"
            android:padding="8dp" />

    </LinearLayout>

</LinearLayout>