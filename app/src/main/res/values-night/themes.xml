<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme (Dark) -->
    <style name="Theme.Monied" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/emerald_400</item>
        <item name="colorPrimaryVariant">@color/emerald_600</item>
        <item name="colorOnPrimary">@color/gray_900</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/emerald_400</item>
        <item name="colorSecondaryVariant">@color/emerald_600</item>
        <item name="colorOnSecondary">@color/gray_900</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/gray_900</item>

        <!-- Background colors -->
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>

        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/text_primary_dark</item>
        <item name="android:textColorSecondary">@color/text_secondary_dark</item>

        <!-- Customize your theme here -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/white</item>

        <!-- Bottom Navigation -->
        <item name="bottomNavigationStyle">@style/Widget.Monied.BottomNavigationView</item>

        <!-- Material Components -->
        <item name="materialButtonStyle">@style/Widget.Monied.Button</item>
        <item name="materialCardViewStyle">@style/Widget.Monied.CardView</item>
        <item name="textInputStyle">@style/Widget.Monied.TextInputLayout</item>
    </style>

    <!-- AppBar / Toolbar for Dark Mode -->
    <style name="Widget.Monied.AppBarLayout" parent="Widget.MaterialComponents.AppBarLayout.Primary">
        <item name="android:background">@color/gray_900</item>
        <item name="android:elevation">4dp</item>
    </style>

    <style name="Widget.Monied.Toolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="titleTextColor">@color/white</item>
        <item name="android:background">@color/gray_900</item>
        <item name="navigationIconTint">@color/white</item>
    </style>

    <!-- Bottom Navigation for Dark Mode -->
    <style name="Widget.Monied.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconTint">@color/bottom_nav_color</item>
        <item name="itemTextColor">@color/bottom_nav_color</item>
        <item name="android:background">@color/gray_800</item>
        <item name="elevation">8dp</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <!-- Card View for Dark Mode -->
    <style name="Widget.Monied.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/gray_800</item>
    </style>
</resources>
